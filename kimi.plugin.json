{
  "name": "flowguard",
  "version": "0.5.0",
  "interface": {
    "displayName": "SDD Governance · FlowGuard",
    "shortDescription": "Ten-stage SDD, evidence freshness and release gates",
    "category": "development"
  },
  "skills": "./skills/",
  "sessionStart": {
    "skill": "flowguard"
  },
  "commands": "./kimi-commands/",
  "hooks": [
    {
      "event": "SessionStart",
      "command": "python3 ./hooks/flowguard_status_summary.py",
      "timeout": 30
    },
    {
      "event": "UserPromptSubmit",
      "command": "python3 ./hooks/flowguard_prompt_guard.py",
      "timeout": 30
    },
    {
      "event": "PreToolUse",
      "command": "python3 ./hooks/flowguard_gate.py",
      "timeout": 120
    },
    {
      "event": "PostToolUse",
      "command": "python3 ./hooks/flowguard_artifact_check.py",
      "timeout": 60
    },
    {
      "event": "PostToolUseFailure",
      "matcher": "Shell",
      "command": "python3 ./hooks/flowguard_artifact_check.py",
      "timeout": 60
    },
    {
      "event": "Stop",
      "command": "python3 ./hooks/flowguard_stage_summary.py",
      "timeout": 30
    }
  ],
  "description": "Agent-driven SDD governance: native Spec Kit/OpenSpec/Superpowers discovery, task binding, evidence freshness and deterministic code/commit/release gates."
}
