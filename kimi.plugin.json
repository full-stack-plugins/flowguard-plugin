{
  "name": "flowguard",
  "version": "0.4.0",
  "interface": {
    "displayName": "研发流程门禁",
    "shortDescription": "智能体 SDD 治理：原生规格、证据与提交门禁",
    "category": "development"
  },
  "skills": "./skills/",
  "sessionStart": {
    "skill": "flowguard"
  },
  "commands": "./kimi-commands/",
  "hooks": [
    {
      "event": "SessionStart",
      "command": "python3 ./hooks/flowguard_status_summary.py",
      "timeout": 30
    },
    {
      "event": "UserPromptSubmit",
      "command": "python3 ./hooks/flowguard_prompt_guard.py",
      "timeout": 30
    },
    {
      "event": "PreToolUse",
      "command": "python3 ./hooks/flowguard_gate.py",
      "timeout": 120
    },
    {
      "event": "PostToolUse",
      "command": "python3 ./hooks/flowguard_artifact_check.py",
      "timeout": 60
    },
    {
      "event": "PostToolUseFailure",
      "matcher": "Shell",
      "command": "python3 ./hooks/flowguard_artifact_check.py",
      "timeout": 60
    },
    {
      "event": "Stop",
      "command": "python3 ./hooks/flowguard_stage_summary.py",
      "timeout": 30
    }
  ],
  "description": "Agent-driven SDD governance for Codex, ZCode, Kimi and Claude: native Spec Kit/OpenSpec/Superpowers discovery, session-worktree task binding, evidence freshness and deterministic code/commit/release gates."
}
